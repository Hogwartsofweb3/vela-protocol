# 🌊 Vela Protocol Keeper - Environment Configuration

# RPC URL for Solana connection
# For production, use your Helius Mainnet URL. For hackathon testing, use Devnet.
RPC_URL=https://api.devnet.solana.com

# Path to the keeper's wallet keypair file
# Run `solana-keygen new -o keeper.json` to generate one.
KEEPER_KEYPAIR_PATH=./keeper.json

# Optional: Ondo API Key (if rate-limited on their public endpoint)
# ONDO_API_KEY=

# Optional: Slack/Discord webhook URL for alerting if the keeper fails
# ALERT_WEBHOOK_URL=
